import math

num1 = float(input("Enter first number: "))
operation = input("Enter operation (+, -, *, /, sqrt, pow): ")
if operation == 'sqrt':
    if num1 < 0:
        result = "Error! Cannot compute square root of a negative number."
    else:
        result = math.sqrt(num1)
else:
    num2 = float(input("Enter second number: "))

if operation == '+':
    result = num1 + num2

elif operation == '-':
    result = num1 - num2

elif operation == '*':
    result = num1 * num2

elif operation == '/':
    result = num1 / num2
    if num2 == 0:
        result = "Error! Division by zero."

elif operation == 'pow':
    result = math.pow(num1, num2) # raise num1 to the power of num2
    if num1 == 0 and num2 <= 0:
        result = "Error! 0 cannot be raised to zero or a negative power."
    if num1 < 0 and not num2.is_integer():
        result = "Error! Negative base with non-integer exponent."

print("The result is:", result)
